# GridWise Environment Variables
# ─────────────────────────────────────────────────────────────
# Get these from:
# Firebase Console → Project Settings → Your apps → Web app → SDK config
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=gridwise-india.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://gridwise-india-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=gridwise-india
VITE_FIREBASE_STORAGE_BUCKET=gridwise-india.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# FCM Web Push VAPID key
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# Google Maps JavaScript API Key
# GCP Console → APIs & Services → Credentials → API Keys
# Enable: Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=your_maps_key_here
